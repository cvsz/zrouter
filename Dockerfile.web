# Dockerfile — zrouter-web (Flask + Gunicorn)
FROM python:3.13-slim

WORKDIR /app

# System dependencies (ca-certificates for HTTPS, curl for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY requirements.txt ./
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Application files (NOT provider.json — keys must come from env)
COPY zrouter.py zrouter_contracts.py zrouter_http.py zrouter_core.py zrouter_bot.py zrouter_bot_models.py zrouter_bot_storage.py zrouter_runtime.py web_app.py models.json ./
COPY templates ./templates
COPY static ./static
COPY gunicorn.conf.py ./

# Non-root user
RUN groupadd -r appuser && useradd -r -g appuser -s /bin/false appuser
RUN chown -R appuser:appuser /app
USER appuser

# Environment
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV WEB_HOST=0.0.0.0
ENV WEB_PORT=8000
ENV NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
ENV NVIDIA_RPM=35
ENV NVIDIA_CACHE_TTL=3600
ENV NVIDIA_TIMEOUT=90
ENV NVIDIA_MAX_WAIT=60

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f -H "Authorization: Bearer ${ROUTER_TOKEN}" http://localhost:8000/health || exit 1

ENTRYPOINT ["gunicorn", "-c", "gunicorn.conf.py", "web_app:app"]
