# zrouter-web environment variables
# Copy to .env and fill in your values

# Required — your NVIDIA API key(s) (comma-separated)
NVIDIA_API_KEYS=nvapi-xxx,nvapi-yyy

# Optional — NVIDIA API base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional — per-key requests per minute (default 35)
NVIDIA_RPM=35

# Optional — cache TTL in seconds (default 3600, 0 = off)
NVIDIA_CACHE_TTL=3600

# Optional — request timeout in seconds (default 90)
NVIDIA_TIMEOUT=90

# Optional — max wait when all keys are rate-limited (default 60)
NVIDIA_MAX_WAIT=60

# Optional — bearer token required by the proxy (strongly recommended for 0.0.0.0).
# Set a strong random value in production. Do not use the default.
ROUTER_TOKEN=

# Web server settings
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_DEBUG=0
WEB_WORKERS=4
WEB_THREADS=8
WEB_LOG_LEVEL=info
